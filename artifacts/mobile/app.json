{
  "expo": {
    "name": "NagarDrishti Mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Capture live road hazards and repair evidence. Gallery uploads are not supported.",
        "NSLocationWhenInUseUsageDescription": "Attach your current GPS position to road hazard and repair evidence."
      }
    },
    "android": {
      "permissions": ["CAMERA", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-splash-screen", {
        "image": "./assets/images/icon.png",
        "imageWidth": 160,
        "backgroundColor": "#0C0E13"
      }],
      ["expo-camera", {
        "cameraPermission": "Capture live road hazards and repair evidence.",
        "recordAudioAndroid": false
      }],
      ["expo-location", {
        "locationWhenInUsePermission": "Attach current GPS coordinates to your live road evidence."
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
